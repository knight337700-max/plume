NODE_ENV=development
APP_ENV=development
QUEUE_PREFIX=development
OPENAI_PROVIDER_MODE=mock
OPENAI_MODEL=gpt-5.6-luna
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://plume:plume_local_only@localhost:5432/plume
TEST_DATABASE_URL=postgresql://plume:plume_local_only@localhost:5432/plume_test
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=plume
S3_SECRET_ACCESS_KEY=plume_local_only
S3_BUCKET=plume-local
OPENAI_API_KEY=
# Live spend guard policy (required only when explicitly enabling Live).
OPENAI_PRICING_VERSION=openai-gpt-5.6-luna-standard-2026-08-03
OPENAI_INPUT_COST_MICRO_USD_PER_MILLION=1000000
OPENAI_OUTPUT_COST_MICRO_USD_PER_MILLION=6000000
OPENAI_CACHED_INPUT_COST_MICRO_USD_PER_MILLION=100000
OPENAI_LIVE_MAX_ESTIMATED_INPUT_TOKENS=250000
OPENAI_LIVE_PER_RUN_SOFT_STOP_MICRO_USD=1000000
OPENAI_LIVE_PER_RUN_HARD_CAP_MICRO_USD=2000000
OPENAI_LIVE_MONTHLY_LIMIT_MICRO_USD=5000000
OPENAI_LIVE_SAFETY_BUFFER_MICRO_USD=500000
OPENAI_LIVE_ABSOLUTE_PROVIDER_CALL_CAP=13
OPENAI_LIVE_BILLING_SCOPE=plume-controlled-live-qa

# Production-only names. Values must come from the approved secret/config manager.
# APP_ENV=production
# QUEUE_PREFIX=plume-production
# PUBLIC_WEB_URL=https://<approved-production-web-domain>
# PUBLIC_API_URL=https://<approved-production-api-domain>
# REQUEST_BODY_LIMIT_BYTES=<user-decision>
# RATE_LIMIT_WINDOW_MS=<user-decision>
# RATE_LIMIT_MAX_REQUESTS=<user-decision>
# UPLOAD_MAX_BYTES=<user-decision>
# UPLOAD_MAX_PIXELS=<user-decision>
# UPLOAD_ALLOWED_MIME_TYPES=<user-decision>
# UPLOAD_SIGNED_URL_TTL_SECONDS=<user-decision>
# OPENAI_LIVE_APPROVED=false
# OPENAI_MONTHLY_BUDGET_USD=<user-decision>
# OPENAI_SOFT_STOP_USD=<user-decision>
# OPENAI_HARD_STOP_USD=<user-decision>
# OPENAI_MAX_CONCURRENCY=1
