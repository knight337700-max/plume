{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/multi-artifact-manifest-v1.0.0.schema.json",
  "title": "Generic Multi-Artifact Collection Manifest v1.0.0",
  "description": "Checksums and fingerprints for ordered source artifacts. It never represents a platform-owned final UI image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "channel",
    "placement",
    "compositionMode",
    "artifactCardinality",
    "sourceProfileId",
    "collectionFingerprint",
    "requestFingerprint",
    "itemCount",
    "items",
    "finalUiRendered",
    "finalUiChecksum",
    "partialPublish"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "COLLECTION_MANIFEST" },
    "channel": { "type": "string", "minLength": 1 },
    "placement": { "type": "string", "minLength": 1 },
    "compositionMode": { "const": "PLATFORM_COMPOSED" },
    "artifactCardinality": { "const": "COLLECTION" },
    "sourceProfileId": { "type": "string", "minLength": 1 },
    "collectionFingerprint": { "$ref": "#/$defs/digest" },
    "requestFingerprint": { "$ref": "#/$defs/digest" },
    "itemCount": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "finalUiRendered": { "const": false },
    "finalUiChecksum": { "type": "null" },
    "partialPublish": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "index",
        "artifactChecksum",
        "pixelFingerprint",
        "requestFingerprint",
        "sourceProfileId",
        "assetId",
        "mime",
        "width",
        "height",
        "bytes",
        "artifactPath"
      ],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "artifactChecksum": { "$ref": "#/$defs/digest" },
        "pixelFingerprint": { "$ref": "#/$defs/digest" },
        "requestFingerprint": { "$ref": "#/$defs/digest" },
        "sourceProfileId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "mime": { "enum": ["image/png", "image/jpeg"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "artifactPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
