{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/placement-provenance-envelope-v1.schema.json",
  "title": "Neutral Placement Provenance Envelope 1.0.0",
  "description": "Optional provenance outside the core placement input; producer identity is advisory only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "envelopeId", "sourceClassification", "producer", "sourceAssetSha256", "capabilitySnapshotSha256", "candidateSha256", "acceptedPlanSha256", "digestScope", "offlineReplay"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "envelopeId": { "type": "string", "minLength": 1 },
    "sourceClassification": { "enum": ["MANUAL", "AGENT", "EXTERNAL_AUTHORING", "DETERMINISTIC", "SAVED_CREATIVE"] },
    "producer": { "type": "object", "additionalProperties": false, "required": ["name", "version", "advisory"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "advisory": { "const": true } } },
    "sourceAssetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilitySnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "acceptedPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digestScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sourceAssetSha256", "capabilitySnapshotSha256", "candidateSha256", "acceptedPlanSha256"] } },
    "timestamp": { "type": "string", "format": "date-time" },
    "offlineReplay": { "const": true }
  }
}
