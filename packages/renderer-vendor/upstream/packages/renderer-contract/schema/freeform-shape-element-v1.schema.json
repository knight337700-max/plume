{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/freeform-shape-element-v1.schema.json",
  "title": "FREEFORM Shape Element v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "bounds", "zIndex", "shape", "fillColor"],
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "type": { "const": "SHAPE" }, "bounds": { "$ref": "#/$defs/normalizedRect" }, "zIndex": { "type": "integer" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }, "role": { "$ref": "#/$defs/semanticRole" }, "safeZoneImportance": { "$ref": "#/$defs/safeZoneImportance" }, "shape": { "enum": ["RECTANGLE", "ELLIPSE"] }, "fillColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" }
  },
  "$defs": {
    "normalizedRect": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } },
    "semanticRole": { "enum": ["HEADLINE", "SUBCOPY", "ADVERTISER", "DISCLAIMER", "CTA", "LOGO", "PRIMARY_IMAGE", "DECORATION", "OTHER"] },
    "safeZoneImportance": { "enum": ["KEY_CREATIVE", "DECORATIVE", "IGNORE"] }
  }
}
