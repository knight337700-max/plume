{
  "name": "plume",
  "version": "0.1.0",
  "private": true,
  "description": "Plume creative workflow platform",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.15.0"
  },
  "devDependencies": {
    "eslint": "9.31.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --workspace vitest.workspace.ts",
    "typecheck": "pnpm --filter @plume/config --filter @plume/web --filter @plume/api --filter @plume/worker --filter @plume/scheduler typecheck"
  }
}
